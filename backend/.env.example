# Copy this to .env and fill in values
DATABASE_URL=postgresql+asyncpg://postgres:Chandu14@localhost:5432/fashion_db
SYNC_DATABASE_URL=postgresql://postgres:Chandu14@localhost:5432/fashion_db

# Proxy settings (residential proxy provider)
PROXY_HOST=your_proxy_host
PROXY_PORT=8080
PROXY_USER=your_proxy_user
PROXY_PASS=your_proxy_pass

# Redis for Celery task queue
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
SECRET_KEY=change_this_to_a_random_secret
